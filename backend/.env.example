# OM2 backend environment variables.
# Copy to backend/.env and fill in values. Never commit backend/.env or real secrets.

# --- Django ---
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# Set to True for local development only.
DJANGO_DEBUG=True
# Comma-separated hostnames.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to send unsafe (POST etc.) requests, e.g. the Vite dev server.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Default display time zone (datetimes are always stored timezone-aware).
DJANGO_TIME_ZONE=Asia/Kolkata

# --- PostgreSQL (local development) ---
# Required: POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD.
POSTGRES_DB=om2
POSTGRES_USER=om2
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Content generation ---
# AI provider used by AI Content Studio:
#   mock   - sample text built from Content DNA; calls no API (default; used by tests)
#   gemini - Google Gemini (needs GEMINI_API_KEY)
# OM2 never falls back to mock: if Gemini fails, the generation shows an error instead.
CONTENT_AI_PROVIDER=mock

# --- Google Gemini (used when CONTENT_AI_PROVIDER=gemini) ---
# Create a key in Google AI Studio (https://aistudio.google.com/apikey). Secret: keep it only
# in backend/.env, never in code, chat or the frontend. OM2 sends it in a request header and
# never logs it.
# Rate limits (requests per minute/day, tokens per minute) and billing belong to the Google
# Cloud project that owns the key. A project without billing uses the free tier, and Google
# may use free-tier prompts to improve its products. OM2 never enables billing or changes
# tiers; check your project's limits in AI Studio.
GEMINI_API_KEY=
# A model with free-tier access, e.g. gemini-3.5-flash-lite (default; fast, higher limits)
# or gemini-3.8-flash (stronger writing, lower free limits).
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for each Gemini response (5-300).
GEMINI_TIMEOUT_SECONDS=60
# Retries for temporary Gemini server or network errors (0-3). Rate limits are not retried.
GEMINI_MAX_RETRIES=1
# Output token cap per call, including any thinking tokens (512-65536).
GEMINI_MAX_OUTPUT_TOKENS=8192
# Optional thinking level for models that support it (e.g. low). Blank uses the model default.
GEMINI_THINKING_LEVEL=
# USD per million tokens, used only for the estimated cost shown in generation history.
# Defaults are Google's paid-tier prices for gemini-3.5-flash-lite; update them if you change
# GEMINI_MODEL. Free-tier usage is not billed.
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50

# --- TinyURL (optional short links in WhatsApp messages) ---
# API token from a TinyURL account (TinyURL > Settings > API > Create token). Secret: keep it
# only in backend/.env. Blank, refused or failing: messages keep the full X compose link.
# Each link is shortened once and cached. Free-plan API limits are set by TinyURL; check
# your account. OM2 never upgrades plans.
TINYURL_API_TOKEN=
# Seconds to wait for TinyURL before using the full link (1-15).
TINYURL_TIMEOUT_SECONDS=4
